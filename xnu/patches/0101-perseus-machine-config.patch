diff --git a/pexpert/pexpert/arm64/PERSEUS.h b/pexpert/pexpert/arm64/PERSEUS.h
new file mode 100644
--- /dev/null
+++ b/pexpert/pexpert/arm64/PERSEUS.h
@@ -0,0 +1,47 @@
+/*
+ * Board config for the Xiaomi Mi Mix 3 4G ("perseus", Qualcomm SDM845 /
+ * Snapdragon 845): Kryo 385 = Cortex-A75 + Cortex-A55, ARMv8.2, no PAC.
+ *
+ * Like polaris this board is built as a sweet variant - ARM64_BOARD_CONFIG_PERSEUS,
+ * ARM64_BOARD_CONFIG_SWEET and plain SWEET are all defined - because
+ * pexpert/arm64/SWEET.h holds no SoC-specific address:
+ *   - generic ARM core (no APPLE_ARM64_ARCH_FAMILY), so none of Apple's
+ *     implementation-defined system registers are touched;
+ *   - ARMv8.2 cores without pointer authentication (Kryo 385 = A75+A55, the same
+ *     ISA level as sweet's Kryo 470 = A76+A55) -> the kernel stays plain arm64
+ *     rather than arm64e; see the PERSEUS override in makedefs/MakeInc.def;
+ *   - GICv3 with two security states: TrustZone owns Group 0, so the timer and
+ *     IPIs arrive as Group 1 IRQs through sleh_irq();
+ *   - architected timer PPIs numbered 1/2/3/0, so the virtual timer XNU uses is
+ *     INTID 16 + 3 = 19;
+ *   - 16K pages, 64-byte cache lines, PSCI CPU_ON, no P/E clusters.
+ *
+ * Nothing in SWEET.h carries an SoC address, so what differs on the Mix 3 is
+ * described in the device tree tools/mkadt.py builds. Against sweet only the
+ * panel changes; against polaris only the UFS aperture - the Mix 3 is otherwise
+ * plain SDM845:
+ *   - panel        1080 x 2340 AMOLED (sweet 1080 x 2400, polaris 1080 x 2160)
+ *   - framebuffer  cont_splash_region 0x9d400000, size 0x2400000 (as sweet)
+ *   - UFS          ufshc@1d84000, aperture 0x2500 (as polaris)
+ *   - GIC          0x17a00000 / 0x17a60000, virtual timer INTID 19 (as sweet)
+ * Taken from the vendor device tree rather than guessed: MiCode/
+ * Xiaomi_Kernel_OpenSource, branch perseus-p-oss, arch/arm64/boot/dts/qcom/
+ * {sdm845.dtsi, perseus-p0.dtsi}. tools/mkadt.py's perseus entry carries the
+ * line references.
+ *
+ * The MAX_* values come from the ARM64_BOARD_CONFIG_SWEET block in
+ * board_config.h and suit SDM845 unchanged for a first boot: 8 cores exposed as
+ * one homogeneous cluster (the A75s are cores 0-3, but the scheduler is not told
+ * they are faster, exactly like sweet). Adding a PERSEUS block here as well
+ * would only redefine them, since both macros are set.
+ */
+
+#ifndef _PEXPERT_ARM64_PERSEUS_H
+#define _PEXPERT_ARM64_PERSEUS_H
+
+#include <pexpert/arm64/SWEET.h>
+
+#define PERSEUS                        1
+#define SDM845                         1
+
+#endif /* ! _PEXPERT_ARM64_PERSEUS_H */
